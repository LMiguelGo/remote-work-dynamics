# Variables de entorno del backend. Copiar a .env y ajustar.
# Los valores de abajo son de ejemplo para desarrollo, nunca secretos reales.

# Puerto donde escucha el backend.
PORT=3000

# Cadena de conexion a PostgreSQL. En el stack de docker-compose el host es el
# nombre del servicio de base y el puerto interno es 5432.
DATABASE_URL=postgresql://postgres:postgres_password@database:5432/rwd_database

# Clave para firmar los JWT de sesion. En produccion poner una cadena larga y
# aleatoria, por ejemplo la salida de `openssl rand -hex 32`.
JWT_SECRET=dev-secret-cambiar-en-produccion

# Broker MQTT por donde llegan las lecturas del ESP32.
MQTT_URL=mqtt://broker-mqtt:1883

# Topico donde el ESP32 publica sus lecturas ambientales.
MQTT_TOPIC=remote-work/esp32/ambiente

# Credenciales del broker. En la demo el broker es anonimo, asi que se dejan
# vacias. Si se activa autenticacion en el broker, llenarlas aqui.
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Token compartido que autentica la ingesta HTTP de sensores. En produccion
# poner una cadena larga y aleatoria, igual que el JWT_SECRET, y cargarla
# tambien en el firmware que envia las lecturas.
INGEST_TOKEN=dev_ingest_token

# Origenes permitidos para CORS, separados por comas. El defecto cubre el nginx
# del frontend y el dev-server de Vite. En produccion fijar aqui el dominio real
# para no quedar abierto a cualquier origen.
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173

GITHUB_WEBHOOK_SECRET=pon-aqui-una-clave-larga-y-aleatoria
GITHUB_TOKEN=pon-aqui-tu-token-de-github
JIRA_STORY_POINTS_FIELD=customfield_10016

# Contenedor de analitica (solo lectura: catalogo de metricas y correlaciones), por la red interna del compose
ANALYTICS_URL=http://analytics:8000
